<Window x:Class="AdhanPrayerTimes.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdhanPrayerTimes.Views"
        mc:Ignorable="d"
        Title="اذان و اوقات شرعی" 
        Height="700" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FlowDirection="RightToLeft">
    
    <Window.Resources>
        <!-- سایه برای کارت‌ها -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="10" 
                          ShadowDepth="2" 
                          Opacity="0.3" 
                          Color="#FF000000"/>
        
        <!-- استایل برای متن‌های عنوان -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF3F51B5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <!-- استایل برای متن‌های معمولی -->
        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FF2C3E50"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <!-- استایل برای مقادیر -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF27AE60"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Border Background="#FFF5F6FA" CornerRadius="15" BorderThickness="1" BorderBrush="#FFD0D0D0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- هدر -->
            <Border Grid.Row="0" Background="#FF3F51B5" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="اذان و اوقات شرعی" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding SelectedCity}" 
                               FontSize="14" 
                               Foreground="#FFE0E0E0" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- تاریخ‌ها -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="تاریخ شمسی:" Style="{StaticResource NormalText}"/>
                            <TextBlock Text="{Binding PersianDate}" Style="{StaticResource ValueText}"/>
                            
                            <TextBlock Text="تاریخ قمری:" Style="{StaticResource NormalText}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding LunarDate}" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="تاریخ میلادی:" Style="{StaticResource NormalText}"/>
                            <TextBlock Text="{Binding GregorianDate}" Style="{StaticResource ValueText}"/>
                            
                            <TextBlock Text="رویداد امروز:" Style="{StaticResource NormalText}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding Events}" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- اوقات شرعی -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="15" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Border Background="#FFECF0F1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🌅 اذان صبح" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Fajr}" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#FF3F51B5"/>
                                </Grid>
                            </Border>
                            
                            <Border Background="#FFECF0F1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="☀️ طلوع آفتاب" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Sunrise}" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#FFF39C12"/>
                                </Grid>
                            </Border>
                            
                            <Border Background="#FFECF0F1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🕌 اذان ظهر" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Dhuhr}" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#FF27AE60"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <Border Background="#FFECF0F1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🌇 غروب آفتاب" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Sunset}" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#FFE74C3C"/>
                                </Grid>
                            </Border>
                            
                            <Border Background="#FFECF0F1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🌙 اذان مغرب" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Maghrib}" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#FF9B59B6"/>
                                </Grid>
                            </Border>
                            
                            <Border Background="#FFECF0F1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🌟 نیمه شب شرعی" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Midnight}" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#FF34495E"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- کنترل‌ها -->
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <ComboBox x:Name="ComboBoxCity" 
                          Style="{StaticResource ModernComboBox}"
                          SelectionChanged="ComboBoxCity_SelectionChanged"
                          Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Content="ذخیره تنظیمات" 
                            Style="{StaticResource ModernButton}"
                            Click="ButtonSave_Click"
                            Grid.Column="0"
                            Margin="0,0,5,0"/>
                    
                    <Button Content="خروج" 
                            Style="{StaticResource ModernButton}"
                            Click="BtnExit_Click"
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            Background="#FFC0392B"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
